# Copied to .env and read by docker-compose.yaml. Only the variables that
# docker-compose.yaml lists under "environment:" reach the container - these
# ones. Everything else (log level, NeuraCell-X, dew point, averaging, ...)
# goes into config.yaml (see config.example.yaml; a variable set here wins
# over the YAML value), or add the variable to docker-compose.yaml yourself.
# The full list is in README.md, "Configuration".
AMBIENTIKA_USER=your@email.com
AMBIENTIKA_PASS=yourpassword
MQTT_HOST=mosquitto
MQTT_PORT=1883
# Required for most brokers (the bundled Mosquitto allows anonymous access only
# if you configure it so).
MQTT_USER=
MQTT_PASSWORD=
# 1 = record a maintenance acknowledgement for a Slave's filter counter
# (needs the persistent /data volume, see docker-compose.yaml)
SLAVE_FILTER_SOFT_RESET=0
